# ============================================
# RUST / CARGO BUILD ARTIFACTS
# ============================================
# Direktori build utama Cargo (termasuk target/debug/app.exe)
/target
**/target/

# Backup file dari rustfmt / editor
*.rs.bk

# Artefak kompilasi Rust
*.rlib
*.rmeta
*.d
*.pdb
*.lib
*.exp
*.ilk
*.idb

# ============================================
# WINDOWS EXECUTABLES & BINARIES
# ============================================
# File executable hasil build di luar folder target
*.exe
*.dll
*.msi
*.bat

# ============================================
# CACHE & TEMPORARY FILES
# ============================================
# Cache Cargo (biasanya di ~/.cargo, tapi bisa muncul lokal)
.cargo/
*.tmp
*.temp
tmp/
temp/

# ============================================
# LOGS
# ============================================
logs/
*.log
npm-debug.log*

# ============================================
# ENVIRONMENT VARIABLES & SECRETS
# ============================================
.env
.env.local
.env.*.local
*.env
!.env.example

# Secret files
*.pem
*.key
*.p12
*.pfx

# ============================================
# TESTING & COVERAGE
# ============================================
coverage/
tarpaulin-report.*
*.profraw
*.profdata
lcov.info

# ============================================
# PROFILING
# ============================================
perf.data
perf.data.old
flamegraph.svg
*.folded

# ============================================
# EDITOR & IDE
# ============================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/

# ============================================
# OS-SPECIFIC FILES
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ============================================
# MISC
# ============================================
*.orig
*.rej
.node_repl_history
*.tgz
